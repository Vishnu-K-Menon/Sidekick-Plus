# Copy this file to .env and fill in the values. Never commit .env.

# Required
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
SERPER_API_KEY=

# Optional: reading web pages (without it, the free fetch server is used locally)
FIRECRAWL_API_KEY=

# Optional: current library documentation
CONTEXT7_API_KEY=

# Optional, local only: read-only GitHub tools
GITHUB_PERSONAL_ACCESS_TOKEN=

# Optional, local only: push notifications
PUSHOVER_TOKEN=
PUSHOVER_USER=

# Optional, local only: email through Resend
RESEND_API_KEY=
LEAD_EMAIL_TO=

# Optional: model overrides
# SIDEKICK_WORKER_MODEL=anthropic:claude-opus-5-5
# SIDEKICK_EVALUATOR_MODEL=gpt-5.5
